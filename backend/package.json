  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/app.test.ts test/security.test.ts",
    "test:db": "node --import tsx --test test/database.integration.test.ts",
